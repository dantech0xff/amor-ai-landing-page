{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "amorai.dantech.academy" }],
      "destination": "https://duoly.dantech.academy/",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "amorai.dantech.academy" }],
      "destination": "https://duoly.dantech.academy/:path*",
      "statusCode": 301
    }
  ]
}
